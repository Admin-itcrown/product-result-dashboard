# Frontend -> API URL (used by Vite via import.meta.env.VITE_API_URL)
VITE_API_URL=

# Optional: Server DB environment overrides (not auto-loaded by server unless you
# load them into the process or use a process manager that reads .env)
DB_USER=sa
DB_PASS=
DB_SERVER=192.168.2.19
DB_PORT=1433
DB_NAME=Db_Sorting
API_PORT=3002
DB_PROFILES=sorting,glaze,kiln,formming,clay

# Profile: sorting -> Db_Sorting
DB_SORTING_NAME=Db_Sorting
